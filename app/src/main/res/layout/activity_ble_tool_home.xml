<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_background">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/xa40"
        android:paddingEnd="@dimen/xa40"
        android:text="采集器调试工具"
        android:textColor="@color/title_bg_white"
        android:textSize="@dimen/sizea_title_big"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/btn_scan_bluetooth"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/btn_scan_bluetooth"
        android:layout_width="0dp"
        android:layout_height="@dimen/xa100"
        android:layout_marginStart="@dimen/xa60"
        android:layout_marginTop="@dimen/xa80"
        android:layout_marginEnd="@dimen/xa60"
        android:background="@drawable/selector_circle_btn_blue"
        android:gravity="center"
        android:text="扫描蓝牙"
        android:textColor="@color/white_background"
        android:textSize="@dimen/sizea_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title" />

</androidx.constraintlayout.widget.ConstraintLayout>
